#!/bin/sh
# preinst for the tarzan package. Until 1.5.4 the unit was shipped as a conffile in
# /etc/systemd/system; from 1.5.5 it is an ordinary package file in
# /lib/systemd/system (#96). dpkg-maintscript-helper retires the old conffile:
# an unmodified copy is removed, an edited one ends up as tarzan.service.dpkg-bak,
# which postinst then moves out of systemd's way.
set -e
dpkg-maintscript-helper rm_conffile /etc/systemd/system/tarzan.service 1.5.5~ -- "$@"
exit 0
