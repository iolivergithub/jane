# Environment for tarzan (read by systemd: EnvironmentFile= in tarzan.service).
# Installed as /etc/opt/jane/tarzan.env, root:root, mode 600.
# After editing: systemctl restart tarzan
# See https://github.com/iolivergithub/jane/blob/main/docs/hardening.md

# Password of the TPM's endorsement hierarchy (#76). Only needed if one has been set
# (tpm2_changeauth -c e ...); most TPMs have none, and then leave this commented out.
# jp reads the same variable from its own environment, e.g. sudo -E /opt/jane/jp ...
#JANE_TPM_ENDORSEMENT_PASSWORD=
