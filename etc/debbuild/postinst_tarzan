#!/bin/sh
# postinst for the tarzan package (tarzan and jp). $1 is "configure"; $2 is
# the previously configured version, empty on a first install.
set -e

DOCS=https://github.com/iolivergithub/jane/blob/main

[ "$1" = "configure" ] || exit 0
PREVIOUS="$2"

# Ownership and permissions. /opt/jane and /etc/opt/jane may be shared with the
# jane package, which sets the directories; only tarzan's own files are changed.
for f in /opt/jane/tarzan /opt/jane/jp; do
    if [ -f "$f" ]; then
        chown root:root "$f"
        chmod 755 "$f"
    fi
done
if [ -f /etc/opt/jane/tarzan.env ]; then
    chown root:root /etc/opt/jane/tarzan.env
    chmod 600 /etc/opt/jane/tarzan.env
fi
if [ -f /etc/opt/jane/provisioning.yaml.example ]; then
    chown root:root /etc/opt/jane/provisioning.yaml.example
    chmod 644 /etc/opt/jane/provisioning.yaml.example
fi
if [ -f /etc/systemd/system/tarzan.service ]; then
    chown root:root /etc/systemd/system/tarzan.service
    chmod 644 /etc/systemd/system/tarzan.service
fi

systemctl daemon-reload
systemctl enable tarzan.service >/dev/null 2>&1 || true
systemctl restart tarzan.service || true

if [ -n "$PREVIOUS" ]; then
    echo "tarzan upgraded from $PREVIOUS and restarted. Changes: $DOCS/CHANGELOG.md"
    exit 0
fi

echo
echo "tarzan is installed and running on port 8530 (HTTP; APIs: sys, tpm2, uefi, ima)."
echo "To register this machine with Jane:"
echo "    cp /etc/opt/jane/provisioning.yaml.example /etc/opt/jane/provisioning.yaml"
echo "    (edit it), then: sudo /opt/jane/jp create --reprovisiontpm /etc/opt/jane/provisioning.yaml"
echo "Quick start: $DOCS/docs/quickstart.md"
echo "tarzan has no authentication; see $DOCS/docs/hardening.md"
echo
exit 0
