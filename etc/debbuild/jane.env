# Environment for janeserver (read by systemd: EnvironmentFile= in jane.service).
# Installed as /etc/opt/jane/jane.env, root:jane, mode 640. Only needed when MongoDB
# or the MQTT broker require an account; with every line commented out (as shipped)
# Jane connects without one. An unset or empty username means "no account".
# Format: KEY=value, one per line; quote values containing spaces or '#'.
# After editing: systemctl restart jane
# See https://github.com/iolivergithub/jane/blob/main/docs/hardening.md

# MongoDB account (#79). AUTHSOURCE is the database the user was created in
# (default: admin, or the authSource in the connection string).
#JANE_MONGODB_USERNAME=jane
#JANE_MONGODB_PASSWORD=
#JANE_MONGODB_AUTHSOURCE=admin

# MQTT broker account (#80).
#JANE_MQTT_USERNAME=jane
#JANE_MQTT_PASSWORD=
