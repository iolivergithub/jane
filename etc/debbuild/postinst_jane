#!/bin/sh
# postinst for the Jane package. $1 is "configure"; $2 is the previously
# configured version, empty on a first install.
set -e

DOCS=https://github.com/iolivergithub/jane/blob/main

[ "$1" = "configure" ] || exit 0
PREVIOUS="$2"

# Jane runs as the unprivileged system user "jane" (see jane.service).
if getent passwd jane >/dev/null; then
    # An existing ordinary account called jane (a person) must not be reused.
    JANE_UID=$(id -u jane)
    FIRST_UID=1000
    if [ -r /etc/adduser.conf ]; then
        F=$(sed -n 's/^FIRST_UID=\([0-9]*\).*/\1/p' /etc/adduser.conf | tail -n 1)
        [ -n "$F" ] && FIRST_UID=$F
    fi
    if [ "$JANE_UID" -ge "$FIRST_UID" ]; then
        echo "jane: an ordinary user account called 'jane' (uid $JANE_UID) already exists."
        echo "jane: Jane needs a system account of that name; rename or remove the existing account and reinstall."
        exit 1
    fi
else
    adduser --system --group --no-create-home --home /nonexistent --quiet jane
fi

# Ownership and permissions (#78), applied on every install and upgrade.
# Binaries and configuration are owned by root so that the jane user cannot
# change them; jane reads its configuration and keys through its group and
# owns only its log. /opt/jane and /etc/opt/jane are shared with the tarzan
# package, so only Jane's own files are changed. /etc/opt/jane is 751: others
# may open files they know the name of (e.g. jp reading the element ID file)
# but cannot list the directory; secrets are protected by their own modes.
chown root:root /opt/jane
chmod 755 /opt/jane
for f in /opt/jane/janeserver /opt/jane/addjaneuser; do
    if [ -f "$f" ]; then
        chown root:root "$f"
        chmod 755 "$f"
    fi
done

chown root:jane /etc/opt/jane
chmod 751 /etc/opt/jane
for f in /etc/opt/jane/config.yaml /etc/opt/jane/jane.env /etc/opt/jane/*.key /etc/opt/jane/*.pem; do
    if [ -f "$f" ]; then
        chown root:jane "$f"
        chmod 640 "$f"
    fi
done
for f in /etc/opt/jane/*.crt /etc/opt/jane/standardintents.json; do
    if [ -f "$f" ]; then
        chown root:jane "$f"
        chmod 644 "$f"
    fi
done

mkdir -p /var/log/jane
chown -R jane:jane /var/log/jane
chmod 750 /var/log/jane
find /var/log/jane -type f -exec chmod 640 {} +

if [ -f /etc/systemd/system/jane.service ]; then
    chown root:root /etc/systemd/system/jane.service
    chmod 644 /etc/systemd/system/jane.service
fi

systemctl daemon-reload
systemctl enable jane.service >/dev/null 2>&1 || true

if [ -n "$PREVIOUS" ]; then
    # Upgrade: restart Jane only if it was running.
    systemctl try-restart jane.service || true
    echo "Jane upgraded from $PREVIOUS (restarted if it was running). Changes: $DOCS/CHANGELOG.md"
    exit 0
fi

# First install: say how to start Jane, and point out missing local services.
# Only a local MongoDB/MQTT broker is checked; a remote one gets no message.
CONF=/etc/opt/jane/config.yaml
is_local() {
    case "$1" in
        *127.0.0.1*|*localhost*|*::1*) return 0 ;;
        *) return 1 ;;
    esac
}
has_unit() {
    systemctl list-unit-files "$1" 2>/dev/null | grep -q "^$1"
}
DBCONN=$(sed -n 's/^[[:space:]]*connection:[[:space:]]*//p' "$CONF" 2>/dev/null | head -n 1)
BROKER=$(sed -n 's/^[[:space:]]*broker:[[:space:]]*//p' "$CONF" 2>/dev/null | head -n 1)

echo
echo "Jane is installed and enabled, but not started."
echo "Default configuration ($CONF): HTTP, no logins, local MongoDB and Mosquitto."
if is_local "$DBCONN" && ! has_unit mongod.service; then
    echo
    echo "MongoDB is required but does not seem to be installed on this machine."
    echo "It is not in Debian; install it from MongoDB's repository: $DOCS/docs/quickstart.md"
fi
if is_local "$BROKER" && ! has_unit mosquitto.service; then
    echo
    echo "An MQTT broker is required but Mosquitto does not seem to be installed: apt install mosquitto"
fi
echo
echo "Start it:     systemctl start jane"
echo "Quick start:  $DOCS/docs/quickstart.md"
echo "Before exposing Jane to a network: $DOCS/docs/hardening.md"
echo
exit 0
