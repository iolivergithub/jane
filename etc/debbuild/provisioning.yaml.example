# Example provisioning file for jp, the Jane element provisioner.
#
# Installed by the tarzan package as /etc/opt/jane/provisioning.yaml.example.
# Copy it and edit the copy, e.g.
#     cp /etc/opt/jane/provisioning.yaml.example /etc/opt/jane/provisioning.yaml
# then check at least:
#   attestationserver  the URL of Jane's REST API (rest: port in Jane's config.yaml, default 8520)
#   element            the name, description and tags this machine is registered under
#   endpoints          where Jane reaches tarzan (default port 8530) and, if used, ratsd
#   tpm2               the TPM device and the EK/AK handles to use
#   provisionworklist  tpmclear and tpmprovision change the TPM; jp asks first unless -u is given
#
#     sudo /opt/jane/jp create /etc/opt/jane/provisioning.yaml   # first provisioning only
#     sudo /opt/jane/jp update /etc/opt/jane/provisioning.yaml   # after firmware (fwupd) or apt updates
#     sudo /opt/jane/jp attest /etc/opt/jane/provisioning.yaml
#
# Note: jp does not send credentials yet, so it cannot be used while Jane's REST API
# requires a login (auth: rest: true in Jane's config.yaml).
# Kept in step with provisioner/skeleton/examplecreateprovisioningfile.yaml.

attestationserver: http://127.0.0.1:8520
element:
  name: Debian13VM
  description: Debian 13 VM
  tags:
    - linux
    - x86
    - tpm2
    - uefi  
    - vbox
endpoints:
  tarzan:
      endpoint: http://127.0.0.1:8530
      protocol: A10HTTPRESTv2
  ratds:
      endpoint: http://127.0.0.1:8895
      protocol: RATSD      
tpm2:
  device:   /dev/tpmrm0   
  ekcerthandle: '0x1C000002'   
  ek:
    handle: '0x810100EE'
  ak:
    handle: '0x810100AA'
provisionworklist:
  - tpmclear
  - tpmprovision
  - collecthostinfo
  - collecttpm2
  - collectuefi
  - collectima
  - makebetterdescription
  - processelement
  - processevs

evs:
  - std::intent::sys::info :
      protocol: tarzan
      type: sysmachineid
      rules: 
        - sys_taRunningSafely  
        - sys_machineID_Agent 
        - sys_machineID_CrossRef 
  # the event log and the PCRs, collected before the quotes, so that the
  # rules can check event log -> PCRs -> quote (cid names a claim's itemid,
  # $name passes it to a rule; see the provisioner README)
  - std::intent::uefi::eventlog :
      protocol: tarzan
      cid: uefilog
  - std::intent::tpm::pcrs :
      protocol: tarzan
      cid: pcrs
      rules:
        - tpm2_uefiLogReplay:
            rid: r_uefilog
            resvar: r_uefilog_code
            parameters: { "uefilogcid": $uefilog }
  - std::intent::sha256::crtm::pcr0 :
      protocol: tarzan
      type: tpm2quote      
      rules:
        - tpm2_attestedValue
        - tpm2_firmware
        - tpm2_magicNumber
        - tpm2_safe
        - tpm2_validNonce 
        - tpm2_pcrDigest:
            parameters: { "pcrscid": $pcrs }
  - std::intent::sha256::crtm::firmware :
      protocol: tarzan
      type: tpm2quote
      rules:
        - tpm2_attestedValue
        - tpm2_firmware
        - tpm2_magicNumber
        - tpm2_safe
        - tpm2_validNonce
        - tpm2_pcrDigest:
            parameters: { "pcrscid": $pcrs }
  - std::intent::sha256::crtm::bootloaderonly  :
      protocol: tarzan
      type: tpm2quote
      rules:
        - tpm2_attestedValue
        - tpm2_firmware
        - tpm2_magicNumber
        - tpm2_safe
        - tpm2_validNonce
        - tpm2_pcrDigest:
            parameters: { "pcrscid": $pcrs }
  - std::intent::linux::ima::asciilog :
      protocol: tarzan
  - std::intent::tpm2::activatecredential :
      protocol: tarzan
      rules:
        - tpm2_credentialActivated
        - tpm2_akAttributes
  # TPM clock, reset and restart counters (signed) and the TPM's identity and
  # configuration (unsigned); no rules yet
  - std::intent::tpm2::gettime :
      protocol: tarzan
  - std::intent::tpm2::capabilities :
      protocol: tarzan
  - std::intent::uefi::efivars :
      protocol: tarzan
      type: uefiefivars
      rules:
        - UEFI_SecureBoot
        - UEFI_SetupMode
        - UEFI_AuditMode
        - UEFI_DeployedMode
        - UEFI_VendorKeys
        - UEFI_PK
        - UEFI_KEK
        - UEFI_db
        - UEFI_MokSBStateRT
        # these change with firmware (fwupd) and shim/SBAT (apt) updates;
        # run jp update afterwards to refresh the expected value
        - UEFI_dbx
        - UEFI_SbatLevelRT
        - UEFI_MokListRT
        - UEFI_MokListXRT
        - UEFI_PKDefault
        - UEFI_KEKDefault
        - UEFI_dbDefault
        - UEFI_dbxDefault
