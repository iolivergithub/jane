#!/bin/sh
# prerm for the tarzan package: on removal stop and disable the service, so systemd
# does not keep trying to start a binary that is no longer there. Nothing is
# done on upgrade (postinst restarts tarzan).
set -e

case "$1" in
    remove|deconfigure)
        systemctl stop tarzan.service >/dev/null 2>&1 || true
        systemctl disable tarzan.service >/dev/null 2>&1 || true
        ;;
esac
exit 0
